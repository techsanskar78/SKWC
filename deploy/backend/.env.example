# Google Sheets (enquiries, appointments, products, gallery)
# 1. Create a Google Cloud service account and download its JSON key
# 2. Create a Google Sheet, then Share it with GOOGLE_SERVICE_ACCOUNT_EMAIL as Editor
# 3. Spreadsheet ID is the long id in the sheet URL: /spreadsheets/d/THIS_ID/edit
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key with \n escaped, wrapped in quotes
GOOGLE_PRIVATE_KEY=

# Google Drive (product / gallery images)
# Create a Drive folder, Share it with the same service account as Editor,
# then paste the folder id from the folder URL: /folders/THIS_ID
GOOGLE_DRIVE_FOLDER_ID=
